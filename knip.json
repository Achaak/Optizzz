{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".claude/**"],
  "workspaces": {
    "apps/extension": {
      "entry": [
        "src/entrypoints/*.ts",
        "src/entrypoints/*/{index,main}.{ts,tsx}",
        "src/features/hunt-launcher/engine/engine.worker.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/game": {
      "project": ["src/**/*.ts"]
    }
  },
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
