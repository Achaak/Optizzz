{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".claude/**"],
  "workspaces": {
    "apps/extension": {
      "entry": [
        "src/entrypoints/*.ts",
        "src/entrypoints/*/{index,main}.{ts,tsx}",
        "src/features/hunt-launcher/engine/engine.worker.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/game": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx,js}", "scripts/**/*.ts"],
      "ignore": ["src/components/ui/**"],
      "ignoreDependencies": ["@prisma/client", "shadcn", "tailwindcss", "tw-animate-css"]
    }
  },
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
