# Copy to .env. Local values match docker-compose.yml.
DATABASE_URL="postgresql://optizzz:optizzz@localhost:5433/optizzz"
# Secret of the revalidation route the cron calls once the exports are stored.
REVALIDATE_SECRET="change-me-to-a-long-random-string"
# Where the cron calls the revalidation route; unset (local runs), it skips it.
# SITE_URL="http://localhost:3000"
# Signs the session cookies of Optizzz accounts (Better Auth), at least 32 characters: openssl rand -hex 32.
BETTER_AUTH_SECRET="change-me-to-a-random-string-of-32-characters-or-more"
# The site's address, used in the magic links: never read from the request. Required in production (`next build`,
# `next start`); unset in dev, it is http://localhost:$PORT (3000 by default). Change it if the site runs elsewhere.
BETTER_AUTH_URL="http://localhost:3000"
# Email provider (Brevo), optional until real sending is set up: unset, the magic link is printed in the server
# console (refused in production). EMAIL_FROM is a sender on a domain verified in Brevo.
# BREVO_API_KEY=""
# EMAIL_FROM="connexion@optizzz.fr"
