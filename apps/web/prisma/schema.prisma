// What the site keeps. Schema « public »: the public exports (docs/features/site-public.md), written by the cron only.
// Schema « accounts »: Optizzz accounts (docs/features/site-comptes-espaces.md), the only part the site writes (docs/adr/0008).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "accounts"]
}

/// The latest version read of each export, per server: the cron downloads only a newer one.
model ExportRead {
  server  String
  /// « players » or « alliances ».
  kind    String
  version String
  readAt  DateTime @updatedAt

  @@id([server, kind])

  @@schema("public")
}

/// A player as the latest export shows it. A player gone from the export is deleted: the Journal says so.
model Player {
  server          String
  id              Int
  pseudo          String
  alliance        String?
  masterId        Int?
  x               Int
  y               Int
  /// Hunting field (TDC), cm²: beyond what a 32-bit integer holds on the biggest servers.
  field           Float
  grade           String?
  buildingScore   Int
  technologyScore Int
  trophyScore     Int
  onHoliday       Boolean
  isBanned        Boolean

  @@id([server, id])
  @@index([server, alliance])
  @@index([server, pseudo])
  @@index([server, field])

  @@schema("public")
}

/// An alliance as the latest export shows it.
model Alliance {
  server               String
  /// As the export writes it; looked up without regard to case.
  tag                  String
  name                 String
  playersCount         Int
  totalField           Float
  totalBuildingScore   Int
  totalTechnologyScore Int
  totalTrophyScore     Int
  /// `{ pacts: { tag, name, description }[], wars: string[] }`, as the export writes it.
  diplomacy            Json

  @@id([server, tag])
  @@index([server, totalField])

  @@schema("public")
}

/// A player's scores on one Paris day, read from that day's first export (the nightly one): the curves.
model PlayerDay {
  server          String
  playerId        Int
  day             DateTime @db.Date
  alliance        String?
  field           Float
  buildingScore   Int
  technologyScore Int
  trophyScore     Int

  @@id([server, playerId, day])
  @@index([server, day])

  @@schema("public")
}

/// An alliance's totals on one Paris day.
model AllianceDay {
  server               String
  tag                  String
  day                  DateTime @db.Date
  playersCount         Int
  totalField           Float
  totalBuildingScore   Int
  totalTechnologyScore Int
  totalTrophyScore     Int

  @@id([server, tag, day])
  @@index([server, day])

  @@schema("public")
}

/// One Change of the Journal: it happened after the export `since` and by the export `until`.
model JournalEntry {
  id       Int      @id @default(autoincrement())
  server   String
  /// The player's id, or null for an alliance's Change.
  playerId Int?
  /// The alliance's tag, or null for a player's Change.
  tag      String?
  /// The player's pseudo or the alliance's tag at `until`, to name it once gone.
  name     String
  since    String
  until    String
  /// The date of `until`.
  at       DateTime
  /// A `Change` of @optizzz/game/changes.
  change   Json

  @@index([server, at])
  @@index([server, playerId, at])
  @@index([server, tag, at])

  @@schema("public")
}

/// A server's map, ready to serve: the columns of @optizzz/map/map-data, as gzipped JSON. Written by the cron with the
/// current state, served as is by `/api/[server]/map` (a function answers at most 4.5 MB: S4 is about 1 MB gzipped).
model MapFile {
  server    String   @id
  version   String
  gzip      Bytes
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// ── Optizzz accounts (Better Auth, magic link). Deleting a user cascades to everything it owns; later
// tickets (declared Players, keys, Alliance Spaces) hang their tables off User with onDelete: Cascade too.

/// An Optizzz account: the email alone. `name` stays empty (Better Auth requires the column).
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  extensions    ExtensionToken[]
  players       DeclaredPlayer[]
  personalKey   PersonalKey?

  @@map("user")
  @@schema("accounts")
}

/// A signed-in browser: 30 days, extended at most once a day. Neither IP address nor user agent is kept.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("accounts")
}

/// How a user signs in, as Better Auth records it (unused by the magic link today, required by Better Auth).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("accounts")
}

/// A pending magic link: its token hashed, 15 minutes, consumed on first use.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("accounts")
}

/// A browser's extension linked to the account (/connect-extension): one token per browser, valid until removed from
/// /account or by « Déconnecter » in the extension. Only the SHA-256 of the token is kept. It opens the extension's API
/// (/api/extension/*) and nothing else: never a session of the site.
model ExtensionToken {
  id        String   @id @default(uuid())
  /// SHA-256 of the token, hex.
  tokenHash String   @unique
  /// « Chrome », « Firefox »… as the extension names its browser, for « Chrome, lié le 24 oct. ».
  browser   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_token")
  @@schema("accounts")
}

/// A Player (a pseudo on a Server) declared by the account's extension, on a click. The primary key makes a Player
/// belong to one account only. Not a proof (ADR 0005): an Admin stays the human check.
model DeclaredPlayer {
  server     String
  /// The player's id in the public export.
  playerId   Int
  /// The pseudo when declared.
  pseudo     String
  declaredAt DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships SpaceMember[]
  requests    JoinRequest[]

  @@id([server, playerId])
  @@index([userId])
  @@map("declared_player")
  @@schema("accounts")
}

// ── Alliance Spaces (docs/features/site-comptes-espaces.md, ADR 0005). The site keeps public keys, locked private
// keys, sealed Clés d'alliance and certificates: never a passphrase, never a key in clear.

/// A person's key pair, born with their first Alliance Space: the Ed25519 public key (base64url) and the private key
/// locked by the Phrase de chiffrement. Also the trust list, encrypted and authenticated for its owner alone, with a
/// revision that grows at each write (two tabs do not overwrite each other, and an older list served is noticed).
model PersonalKey {
  userId            String   @id
  publicKey         String   @unique
  lockedPrivateKey  String
  trustList         String?
  trustListRevision Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("personal_key")
  @@schema("accounts")
}

/// An Alliance Space, on a server, for an alliance tag read from the export. Several may carry the same tag. Its id is
/// drawn by the creator's browser: the Clé d'alliance is sealed and signed for it before the space exists on the site.
model Space {
  id           String             @id
  server       String
  tag          String
  name         String
  createdAt    DateTime           @default(now())
  members      SpaceMember[]
  requests     JoinRequest[]
  certificates SpaceCertificate[]

  @@index([server, tag])
  @@map("space")
  @@schema("accounts")
}

enum SpaceRole {
  admin
  delegate
  member

  @@schema("accounts")
}

/// A Player in a space, with its role. A Player is in one space at most. `publicKey` is the key its Clés d'alliance are
/// last sealed for: another key than the account's today means « clé à renvoyer » (passphrase forgotten, boxes deleted)
/// until an Admin seals them again; the old key stays, for a revocation to name it.
model SpaceMember {
  spaceId    String
  server     String
  playerId   Int
  role       SpaceRole
  joinedAt   DateTime            @default(now())
  publicKey  String
  space      Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  player     DeclaredPlayer      @relation(fields: [server, playerId], references: [server, playerId], onDelete: Cascade)
  sealedKeys SealedAllianceKey[]

  @@id([spaceId, server, playerId])
  @@unique([server, playerId])
  @@map("space_member")
  @@schema("accounts")
}

/// One version of the Clé d'alliance, sealed for a member and signed by the Admin who sealed it (ADR 0005, format 2).
/// The version in clear is only for sorting: the one in the box, signed, is what counts.
model SealedAllianceKey {
  spaceId  String
  server   String
  playerId Int
  version  Int
  sealed   String
  sealedAt DateTime    @default(now())
  member   SpaceMember @relation(fields: [spaceId, server, playerId], references: [spaceId, server, playerId], onDelete: Cascade)

  @@id([spaceId, server, playerId, version])
  @@map("sealed_alliance_key")
  @@schema("accounts")
}

enum JoinRequestStatus {
  pending
  refused

  @@schema("accounts")
}

/// A request to join a space: one per space and Player, pending or refused (« refusée le … »), without a message.
model JoinRequest {
  id        String            @id @default(uuid())
  spaceId   String
  server    String
  playerId  Int
  status    JoinRequestStatus @default(pending)
  createdAt DateTime          @default(now())
  decidedAt DateTime?
  space     Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  player    DeclaredPlayer    @relation(fields: [server, playerId], references: [server, playerId], onDelete: Cascade)

  @@unique([spaceId, server, playerId])
  @@map("join_request")
  @@schema("accounts")
}

/// A certificate or a revocation signed by an Admin of the space (ADR 0005, « Certificat »): nothing secret, kept in
/// clear for every member's browser to work out whom to believe.
model SpaceCertificate {
  spaceId   String
  blob      String
  createdAt DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, blob])
  @@map("space_certificate")
  @@schema("accounts")
}
