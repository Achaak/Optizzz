// What the site keeps. Schema « public »: the public exports (docs/features/site-public.md), written by the cron only.
// Schema « accounts »: Optizzz accounts (docs/features/site-comptes-espaces.md), the only part the site writes (docs/adr/0008).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "accounts"]
}

/// The latest version read of each export, per server: the cron downloads only a newer one.
model ExportRead {
  server  String
  /// « players » or « alliances ».
  kind    String
  version String
  readAt  DateTime @updatedAt

  @@id([server, kind])
  @@schema("public")
}

/// A player as the latest export shows it. A player gone from the export is deleted: the Journal says so.
model Player {
  server          String
  id              Int
  pseudo          String
  alliance        String?
  masterId        Int?
  x               Int
  y               Int
  /// Hunting field (TDC), cm²: beyond what a 32-bit integer holds on the biggest servers.
  field           Float
  grade           String?
  buildingScore   Int
  technologyScore Int
  trophyScore     Int
  onHoliday       Boolean
  isBanned        Boolean

  @@id([server, id])
  @@index([server, alliance])
  @@index([server, pseudo])
  @@index([server, field])
  @@schema("public")
}

/// An alliance as the latest export shows it.
model Alliance {
  server               String
  /// As the export writes it; looked up without regard to case.
  tag                  String
  name                 String
  playersCount         Int
  totalField           Float
  totalBuildingScore   Int
  totalTechnologyScore Int
  totalTrophyScore     Int
  /// `{ pacts: { tag, name, description }[], wars: string[] }`, as the export writes it.
  diplomacy            Json

  @@id([server, tag])
  @@index([server, totalField])
  @@schema("public")
}

/// A player's scores on one Paris day, read from that day's first export (the nightly one): the curves.
model PlayerDay {
  server          String
  playerId        Int
  day             DateTime @db.Date
  alliance        String?
  field           Float
  buildingScore   Int
  technologyScore Int
  trophyScore     Int

  @@id([server, playerId, day])
  @@index([server, day])
  @@schema("public")
}

/// An alliance's totals on one Paris day.
model AllianceDay {
  server               String
  tag                  String
  day                  DateTime @db.Date
  playersCount         Int
  totalField           Float
  totalBuildingScore   Int
  totalTechnologyScore Int
  totalTrophyScore     Int

  @@id([server, tag, day])
  @@index([server, day])
  @@schema("public")
}

/// One Change of the Journal: it happened after the export `since` and by the export `until`.
model JournalEntry {
  id       Int      @id @default(autoincrement())
  server   String
  /// The player's id, or null for an alliance's Change.
  playerId Int?
  /// The alliance's tag, or null for a player's Change.
  tag      String?
  /// The player's pseudo or the alliance's tag at `until`, to name it once gone.
  name     String
  since    String
  until    String
  /// The date of `until`.
  at       DateTime
  /// A `Change` of @optizzz/game/changes.
  change   Json

  @@index([server, at])
  @@index([server, playerId, at])
  @@index([server, tag, at])
  @@schema("public")
}

/// A server's map, ready to serve: the columns of @optizzz/map/map-data, as gzipped JSON. Written by the cron with the
/// current state, served as is by `/api/[server]/map` (a function answers at most 4.5 MB: S4 is about 1 MB gzipped).
model MapFile {
  server    String   @id
  version   String
  gzip      Bytes
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// ── Optizzz accounts (Better Auth, magic link). Deleting a user cascades to everything it owns; later
// tickets (declared Players, keys, Alliance Spaces) hang their tables off User with onDelete: Cascade too.

/// An Optizzz account: the email alone. `name` stays empty (Better Auth requires the column).
model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sessions      Session[]
  accounts      Account[]
  extensions    ExtensionToken[]
  players       DeclaredPlayer[]
  personalKey   PersonalKey?

  @@map("user")
  @@schema("accounts")
}

/// A signed-in browser: 30 days, extended at most once a day. Neither IP address nor user agent is kept.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("accounts")
}

/// How a user signs in, as Better Auth records it (unused by the magic link today, required by Better Auth).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("accounts")
}

/// A pending magic link: its token hashed, 15 minutes, consumed on first use.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("accounts")
}

/// A browser's extension linked to the account (/connect-extension): one token per browser, valid until removed from
/// /account or by « Déconnecter » in the extension. Only the SHA-256 of the token is kept. It opens the extension's API
/// (/api/extension/*) and nothing else: never a session of the site.
model ExtensionToken {
  id        String   @id @default(uuid())
  /// SHA-256 of the token, hex.
  tokenHash String   @unique
  /// « Chrome », « Firefox »… as the extension names its browser, for « Chrome, lié le 24 oct. ».
  browser   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_token")
  @@schema("accounts")
}

/// A Player (a pseudo on a Server) declared by the account's extension, on a click. The primary key makes a Player
/// belong to one account only. Not a proof (ADR 0005): an Admin stays the human check.
model DeclaredPlayer {
  server        String
  /// The player's id in the public export.
  playerId      Int
  /// The pseudo when declared.
  pseudo        String
  declaredAt    DateTime       @default(now())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships   SpaceMember[]
  requests      JoinRequest[]
  envoiSettings EnvoiSettings?
  envois        EnvoiItem[]
  demandes      Demande[]

  @@id([server, playerId])
  @@index([userId])
  @@map("declared_player")
  @@schema("accounts")
}

// ── Alliance Spaces (docs/features/site-comptes-espaces.md, ADR 0005). The site keeps public keys, locked private
// keys, sealed Clés d'alliance and certificates: never a passphrase, never a key in clear.

/// A person's key pair, born with their first Alliance Space: the Ed25519 public key (base64url) and the private key
/// locked by the Phrase de chiffrement. Also the trust list, encrypted and authenticated for its owner alone, with a
/// revision that grows at each write (two tabs do not overwrite each other, and an older list served is noticed).
model PersonalKey {
  userId            String   @id
  publicKey         String   @unique
  lockedPrivateKey  String
  trustList         String?
  trustListRevision Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("personal_key")
  @@schema("accounts")
}

/// An Alliance Space, on a server, for an alliance tag read from the export. Several may carry the same tag. Its id is
/// drawn by the creator's browser: the Clé d'alliance is sealed and signed for it before the space exists on the site.
model Space {
  id            String               @id
  server        String
  tag           String
  name          String
  createdAt     DateTime             @default(now())
  members       SpaceMember[]
  requests      JoinRequest[]
  certificates  SpaceCertificate[]
  keyVersions   AllianceKeyVersion[]
  absenceAlerts SpaceAbsenceAlerts?
  envois        EnvoiItem[]
  discord       SpaceDiscord?
  demandes      Demande[]
  reminders     SpaceReminders?
  remindersSent SpaceReminderSent[]

  @@index([server, tag])
  @@map("space")
  @@schema("accounts")
}

enum SpaceRole {
  admin
  delegate
  member

  @@schema("accounts")
}

/// A Player in a space, with its role. A Player is in one space at most. `publicKey` is the key its Clés d'alliance are
/// last sealed for: another key than the account's today means « clé à renvoyer » (passphrase forgotten, boxes deleted)
/// until an Admin seals them again; the old key stays, for a revocation to name it.
model SpaceMember {
  spaceId      String
  server       String
  playerId     Int
  role         SpaceRole
  joinedAt     DateTime            @default(now())
  publicKey    String
  /// « Accès à renvoyer » after an Admin's withdrawal by an Admin who did not believe this member's key: the boxes stay
  /// (older data stays readable) until an Admin seals every version again (ticket 18b).
  resendNeeded Boolean             @default(false)
  space        Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  player       DeclaredPlayer      @relation(fields: [server, playerId], references: [server, playerId], onDelete: Cascade)
  sealedKeys   SealedAllianceKey[]

  @@id([spaceId, server, playerId])
  @@unique([server, playerId])
  @@map("space_member")
  @@schema("accounts")
}

/// One version of the Clé d'alliance, sealed for a member and signed by the Admin who sealed it (ADR 0005, format 2).
/// The version in clear is only for sorting: the one in the box, signed, is what counts.
model SealedAllianceKey {
  spaceId  String
  server   String
  playerId Int
  version  Int
  sealed   String
  sealedAt DateTime    @default(now())
  member   SpaceMember @relation(fields: [spaceId, server, playerId], references: [spaceId, server, playerId], onDelete: Cascade)

  @@id([spaceId, server, playerId, version])
  @@map("sealed_alliance_key")
  @@schema("accounts")
}

/// The versions of a space's Clé d'alliance, by number: one row each, so that two Admins who change the key at once
/// cannot both write a version N (ADR 0005, « Modèle de confiance ») : the database refuses the second.
model AllianceKeyVersion {
  spaceId         String
  version         Int
  createdAt       DateTime @default(now())
  /// The pseudo of the Admin who made it (the creator for version 1), for « Accès changé le … par Pseudo (version N) ».
  /// Null for the versions made before ticket 20.
  createdByPseudo String?
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, version])
  @@map("alliance_key_version")
  @@schema("accounts")
}

/// The absence alerts of a space (members missing from the game's Members page, and since when), encrypted with the
/// Clé d'alliance in an Admin's or a Délégué's browser: the site cannot read them. The revision grows at each write.
model SpaceAbsenceAlerts {
  spaceId   String   @id
  blob      String
  revision  Int
  updatedAt DateTime @updatedAt
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("space_absence_alerts")
  @@schema("accounts")
}

/// The space's Discord webhook (docs/features/site-discord.md): its address and the kinds of events that go there,
/// encrypted with the Clé d'alliance in an Admin's browser; the site cannot read them. The revision grows at each
/// write. `refused…`: the last refusal of the webhook a member's extension reported for that revision (Discord's HTTP
/// status, when, from whose extension), content-free, for the Admins' « Discord a refusé le dernier message ».
model SpaceDiscord {
  spaceId         String    @id
  blob            String
  revision        Int
  updatedAt       DateTime  @updatedAt
  refusedRevision Int?
  refusedStatus   Int?
  refusedAt       DateTime?
  refusedByPseudo String?
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("space_discord")
  @@schema("accounts")
}

/// The site's own reminders on Discord (docs/features/site-discord.md, « Rappels du site », ADR 0005 « Discord »): a
/// second webhook, not the announcements' one, whose address the site reads. Encrypted at rest with the site's key
/// (DISCORD_REMINDERS_KEY, src/server/reminders/at-rest.ts): a stolen copy of the database does not give it, whoever
/// runs the site does. `kinds`: the events an Admin switched on. `suspended…`: Discord said the webhook is gone (401,
/// 404); no reminder leaves until an Admin saves an address again.
model SpaceReminders {
  spaceId         String    @id
  sealedUrl       String
  kinds           String[]
  updatedAt       DateTime  @updatedAt
  suspendedStatus Int?
  suspendedAt     DateTime?
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("space_reminders")
  @@schema("accounts")
}

/// When the site last posted a reminder of a kind for a space: one at most every 30 minutes, claimed by a conditional
/// write before posting.
model SpaceReminderSent {
  spaceId String
  kind    String
  sentAt  DateTime
  space   Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, kind])
  @@map("space_reminder_sent")
  @@schema("accounts")
}

enum JoinRequestStatus {
  pending
  refused

  @@schema("accounts")
}

/// A request to join a space: one per space and Player, pending or refused (« refusée le … »), without a message.
model JoinRequest {
  id        String            @id @default(uuid())
  spaceId   String
  server    String
  playerId  Int
  status    JoinRequestStatus @default(pending)
  createdAt DateTime          @default(now())
  decidedAt DateTime?
  space     Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  player    DeclaredPlayer    @relation(fields: [server, playerId], references: [server, playerId], onDelete: Cascade)

  @@unique([spaceId, server, playerId])
  @@map("join_request")
  @@schema("accounts")
}

/// A certificate or a revocation signed by an Admin of the space (ADR 0005, « Certificat »): nothing secret, kept in
/// clear for every member's browser to work out whom to believe.
model SpaceCertificate {
  spaceId   String
  blob      String
  createdAt DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, blob])
  @@map("space_certificate")
  @@schema("accounts")
}

// ── Envois (docs/features/site-envois.md, ADR 0005). The site keeps what extensions encrypted with the Clé d'alliance:
// it sees who sent a row, in which space and category, its fingerprint and when it may forget it, never what it says.

/// What a Joueur sends, chosen in their extension (« Fonctionnalités » → « Compte Optizzz »), shown on the space page:
/// « convoys », « army-count »… (SENT_CATEGORIES of @optizzz/game/site-links/envois).
model EnvoiSettings {
  server     String
  playerId   Int
  categories String[]
  updatedAt  DateTime       @updatedAt
  player     DeclaredPlayer @relation(fields: [server, playerId], references: [server, playerId], onDelete: Cascade)

  @@id([server, playerId])
  @@map("envoi_settings")
  @@schema("accounts")
}

/// One item of a list category (a convoy), encrypted with the Clé d'alliance by the extension of the Joueur who read
/// it. In clear only: the space, the Joueur, the category, the fingerprint (keyed with the Clé d'alliance, it tells
/// the same convoy reported by its sender and its recipient apart from others without saying who or how much), the
/// key version, and when it may be forgotten (90 days after the convoy's arrival). Leaving the space keeps the rows
/// (the alliance's history); deleting the account or the space erases them.
model EnvoiItem {
  id          String         @id @default(uuid())
  spaceId     String
  server      String
  playerId    Int
  category    String
  fingerprint String
  blob        String
  /// The Admins' blob (the army sent with a flood), encrypted with the same Clé d'alliance: the site hands it to the
  /// space's Admins only. Reserved by the site, not by the encryption (docs/features/site-envois.md).
  detail      String?
  keyVersion  Int
  expiresAt   DateTime
  updatedAt   DateTime       @default(now())
  space       Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  player      DeclaredPlayer @relation(fields: [server, playerId], references: [server, playerId], onDelete: Cascade)

  @@unique([spaceId, server, playerId, category, fingerprint])
  @@index([spaceId, updatedAt])
  @@index([expiresAt])
  @@map("envoi_item")
  @@schema("accounts")
}

// ── Demandes (docs/features/site-demandes.md, ADR 0005). What a Demande asks for is encrypted with the Clé d'alliance
// in its requester's browser; the site sees who asked, in which space, its status, its order and its dates.

enum DemandeStatus {
  pending
  validated
  refused
  closed
  cancelled

  @@schema("accounts")
}

/// A Demande: a Joueur asks the alliance for resources for a building or a research. In clear only what the site needs
/// to apply its rules: the requester, the space, the status (who may change it and when), the requester's order, the
/// dates and the pseudo of the Admin or Délégué who decided. The building, the levels and the amounts are in `blob`,
/// sealed for this row (id, server, Joueur). Its id is drawn by the requester's browser, which seals the blob for it.
/// Closed, cancelled or refused, it goes 90 days later (`expiresAt`); leaving the space keeps it, deleting the account
/// or the space erases it.
model Demande {
  id              String         @id
  spaceId         String
  server          String
  playerId        Int
  status          DemandeStatus  @default(pending)
  /// The requester's order among their Demandes: 0 first.
  rank            Int
  blob            String
  keyVersion      Int
  createdAt       DateTime       @default(now())
  /// Any change, for the relève of the extensions.
  updatedAt       DateTime       @default(now())
  decidedAt       DateTime?
  decidedByPseudo String?
  /// Closed, cancelled or refused.
  endedAt         DateTime?
  expiresAt       DateTime?
  space           Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  player          DeclaredPlayer @relation(fields: [server, playerId], references: [server, playerId], onDelete: Cascade)

  @@index([spaceId, updatedAt])
  @@index([server, playerId])
  @@map("demande")
  @@schema("accounts")
}
