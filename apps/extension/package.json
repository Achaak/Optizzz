{
  "name": "@optizzz/extension",
  "version": "1.12.0",
  "private": true,
  "description": "Extension navigateur d'aide au jeu Fourmizzz.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "analyze": "wxt build --analyze --analyze-open",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@optizzz/game": "workspace:*",
    "@optizzz/map": "workspace:*",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "author": "Axel Lavoie",
  "repository": {
    "type": "git",
    "url": "https://github.com/Achaak/Optizzz"
  }
}
