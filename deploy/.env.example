# /opt/optizzz/.env on the VPS, written by scripts/setup-vps.sh. Never committed.
# The version online, set by deploy.sh at each deployment.
TAG=
# The database: its owner (migrations, ingest) and the site's role optizzz_app. Hex only: they go in URLs.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# The site's secrets (apps/web/.env.example).
REVALIDATE_SECRET=
BETTER_AUTH_SECRET=
BREVO_API_KEY=
EMAIL_FROM=
DISCORD_REMINDERS_KEY=
# The back office's admins (/admin): addresses separated by commas; empty, nobody.
ADMIN_EMAILS=
# The daily backup's copy on Scaleway Object Storage (backup.sh); empty, the backups stay on the VPS only.
BACKUP_BUCKET=
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
