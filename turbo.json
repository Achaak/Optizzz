{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "REVALIDATE_SECRET", "SKIP_ENV_VALIDATION"],
      "outputs": [".output/chrome-mv3/**", ".next/**", "!.next/cache/**"]
    },
    "build:firefox": {
      "dependsOn": ["^build"],
      "outputs": [".output/firefox-mv3/**"]
    },
    "typecheck": {},
    "test": {}
  }
}
