{
  "name": "optizzz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @optizzz/extension dev",
    "dev:firefox": "pnpm --filter @optizzz/extension dev:firefox",
    "build": "turbo run build",
    "build:firefox": "turbo run build:firefox",
    "analyze": "pnpm --filter @optizzz/extension analyze",
    "zip": "pnpm --filter @optizzz/extension zip",
    "zip:firefox": "pnpm --filter @optizzz/extension zip:firefox",
    "typecheck": "turbo run typecheck",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:firefox": "pnpm --filter @optizzz/extension lint:firefox",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "license": "MIT",
  "author": "Axel Lavoie",
  "repository": {
    "type": "git",
    "url": "https://github.com/Achaak/Optizzz"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  }
}
